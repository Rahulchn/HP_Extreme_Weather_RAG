# Hugging Face Inference API Configuration
# Note: Configured for the available Hugging Face inference/free-access allowance.
# Provider availability and rate limits may vary.

# Your Hugging Face user access token (Read permission)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=

# Model identifier (Selects exactly ONE model; no silent fallbacks)
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Generation & client parameters
# HF_TIMEOUT: 1-300 seconds
# HF_TEMPERATURE: 0.0-2.0
# HF_MAX_TOKENS: 1-32768
HF_TIMEOUT=30
HF_TEMPERATURE=0.1
HF_MAX_TOKENS=1024
